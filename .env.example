# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# --- Model providers --------------------------------------------------------
# Optional: ingestion and retrieval work without these. When absent, the
# corresponding client fails to initialise and /health/ready reports degraded.
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT=60
COHERE_API_KEY=
COHERE_TIMEOUT=30
RERANK_MODEL=rerank-v3.5
RERANK_ENABLED=true

# --- API security -----------------------------------------------------------
APP_ENV=development
# Legacy single-tenant mode only (when DATABASE_URL is empty): comma-separated
# keys accepted on X-API-Key. When DATABASE_URL is set, each agency gets its
# own key from the tenants table instead — leave API_KEYS empty in production.
API_KEYS=
# High-privilege key for /auth/register and /admin/*. Required to onboard new
# agencies in production. Never expose this in the browser or give it to customers.
ADMIN_API_KEY=
# Signing key for browser login JWTs (set a long random string in production).
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# Set to false to disable self-service registration (admin-only onboarding).
PUBLIC_SIGNUP_ENABLED=true
# Must be true together with PUBLIC_SIGNUP_ENABLED when APP_ENV=production (SaaS mode).
ALLOW_PUBLIC_SIGNUP_IN_PRODUCTION=false
# Optional platform-wide tone for every tenant (see also per-org custom_instructions in DB).
RAG_PERSONA=
# Default prompt pack: file src/core/prompts/{PROMPT_PACK_ID}.json (bump "version" inside JSON to roll out).
PROMPT_PACK_ID=default
# Comma-separated origins allowed to call the API from a browser.
# Production: https://your public site only (must match SITE_DOMAIN).
CORS_ORIGINS=http://localhost:5173,http://localhost
RATE_LIMIT_PER_MINUTE=30
MAX_QUERY_CHARS=2000

# --- Production TLS (docker compose frontend / Caddy) -----------------------
# Leave SITE_DOMAIN empty for local HTTP on port 80. Set to your hostname for automatic HTTPS.
SITE_DOMAIN=
CADDY_EMAIL=
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# --- PostgreSQL credentials (compose + APP_ENV=production validation) -------
POSTGRES_USER=raguser
# Dev default only — use scripts/setup_production_env.py for production secrets.
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb
# In docker-compose this is served by the `qdrant` service.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=finance_documents_v1
QDRANT_TIMEOUT=120
# Only used when QDRANT_URL is empty (single-process embedded mode).
QDRANT_DB_DIR=./qdrant_db_local

# --- Local storage ----------------------------------------------------------
# Used only when DATABASE_URL is empty (single-tenant, no Postgres).
DOC_STORE_DIR=./doc_store_local
RAW_PDFS_DIR=./real_pdfs
BM25_INDEX_FILE=bm25_index.pkl
INGESTION_MANIFEST_FILE=ingestion_manifest.json

# --- PostgreSQL (multi-tenant document store + full-text keyword index) -----
# When set, parent documents and the BM25 keyword index live in Postgres
# (PostgresDocStore + PostgresBM25Retriever) instead of the local pickle files,
# and authentication resolves tenants from the `tenants` table. This is what
# enables multi-tenancy; leave empty for local development.
# Example: DATABASE_URL=postgresql+psycopg://raguser:YOUR_PASSWORD@localhost:5432/ragdb
DATABASE_URL=

# --- Async ingestion (Celery) -----------------------------------------------
# The Celery worker reuses Redis as both broker and result backend. Override
# only if you run a dedicated broker.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_URL=redis://localhost:6379/0

# --- Embeddings -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Chunking ---------------------------------------------------------------
PARENT_CHUNK_SIZE=4000
CHILD_CHUNK_SIZE=700
CHILD_CHUNK_OVERLAP=80

# --- Retrieval --------------------------------------------------------------
BM25_K=8
VECTOR_K=8
VECTOR_FETCH_K=20
# [bm25, vector] fusion weights
ENSEMBLE_WEIGHTS=0.4,0.6
RERANK_MAX_CANDIDATES=40
# Minimum reranker relevance for a passage to be cited. If none clear it, the
# service declines to answer instead of citing unrelated documents.
# A real match scores ~0.85-0.95; an off-corpus query scores below 0.1.
RERANK_MIN_SCORE=0.30

# --- Semantic cache ---------------------------------------------------------
# Requires Redis Stack (redis-stack-server) for the vector index.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.88
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_CANDIDATES=3
REDIS_URL=redis://localhost:6379/0

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
